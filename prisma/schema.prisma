// BusinessOS — Prisma schema
//
// Scope of this file today: Identity, Tenancy and Access (report Section 39,
// items 6 and 11). People / Work / Finance models arrive in later phases.
//
// Conventions (Appendix B):
//   - Prisma models are PascalCase; physical tables are snake_case via @@map.
//   - IDs are opaque UUIDv7 strings. v7 is time-ordered, so `id` doubles as a
//     stable keyset-pagination cursor (Section 16.1) without a second column.
//
// Tenancy rule (Section 9.2): every tenant-owned table carries organization_id,
// and every composite index on those tables leads with it (Section 10.3).

generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — global, NOT tenant-scoped
// ---------------------------------------------------------------------------

/// A human. Deliberately global: one person may belong to several
/// organizations (transcript: "Hrishikesh -> Vernost, Demo Company"), so
/// identity cannot live inside a tenant.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Stored lowercase + trimmed. Normalization happens in the application layer
  /// so the uniqueness guarantee and the lookup path agree.
  email        String     @unique @db.VarChar(320)
  /// Argon2id (Section 18.2). Null while an invited account has not completed
  /// signup, or when identity is external (SSO, later).
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  name         String     @db.VarChar(120)
  status       UserStatus @default(PENDING_VERIFICATION)

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  sessions        Session[]
  auditLogs       AuditLog[]
  sentInvitations Invitation[]  @relation("InvitationInviter")
  employeeRecords Employee[]
  taskComments    TaskComment[]

  @@index([status])
  @@map("users")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

/// An authenticated browser session (Section 18.2).
/// Only the SHA-256 of the session token is stored — a database leak must not
/// hand the attacker usable sessions.
model Session {
  id        String @id @default(uuid(7)) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)

  /// Denormalized copy of the org this session last acted in, so tenant context
  /// survives a refresh. Authorization still re-checks membership on every
  /// request — this is a convenience, never a grant.
  activeOrganizationId String? @map("active_organization_id") @db.Uuid

  ipAddress String?   @map("ip_address") @db.Inet
  userAgent String?   @map("user_agent") @db.VarChar(512)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// The tenant root. Section 9.2: shared database, shared schema, tenant key.
model Organization {
  id     String             @id @default(uuid(7)) @db.Uuid
  name   String             @db.VarChar(160)
  /// Tenant-local URL identifier. Globally unique because it appears in paths.
  slug   String             @unique @db.VarChar(64)
  status OrganizationStatus @default(ACTIVE)

  timezone String @default("Asia/Kolkata") @db.VarChar(64)
  /// ISO 4217. Section 28.2: Money is always amount + currency, never a bare float.
  currency String @default("INR") @db.Char(3)

  /// Optimistic concurrency (Section 11.2). Settings updates bump this; a stale
  /// write matches zero rows and returns 409 instead of silently clobbering.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships Membership[]
  roles       Role[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  departments Department[]
  employees   Employee[]
  projects    Project[]
  tasks       Task[]

  @@index([status])
  @@map("organizations")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

/// User <-> Organization. This row IS the tenant authorization boundary:
/// Section 9.3 requires membership be proven before any tenant-scoped operation.
model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)

  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  /// One membership per person per org.
  @@unique([organizationId, userId])
  /// "List the members of this org, active first" — the directory query.
  @@index([organizationId, status])
  /// "Which orgs can this user switch to?" — the org switcher.
  @@index([userId, status])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED

  @@map("membership_status")
}

// ---------------------------------------------------------------------------
// Access — RBAC (Section 18.3)
// ---------------------------------------------------------------------------

/// Roles are per-tenant so an org can define its own, but the system roles
/// (OWNER/ADMIN/HR/MANAGER/FINANCE/EMPLOYEE) are seeded per org and locked.
model Role {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Stable machine key, e.g. "hr". Business logic keys off permissions, not
  /// this — Section 18.3: "use permission keys rather than role names".
  key            String  @db.VarChar(64)
  name           String  @db.VarChar(80)
  description    String? @db.VarChar(255)
  /// System roles cannot be renamed or deleted through the API.
  isSystem       Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// Global permission catalogue — the same keys mean the same thing in every
/// tenant, so this table is intentionally NOT tenant-scoped.
model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  /// "<module>.<action>", e.g. "employee.read", "expense.approve".
  key         String @unique @db.VarChar(80)
  module      String @db.VarChar(40)
  description String @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A member may hold several roles; effective permissions are the union.
/// Section 26.1 resolves that union into a Set once per request.
model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

// ---------------------------------------------------------------------------
// Invitations
// ---------------------------------------------------------------------------

model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String           @db.VarChar(320)
  roleId         String           @map("role_id") @db.Uuid
  /// Same reasoning as Session.tokenHash — the raw token only ever exists in
  /// the invite email.
  tokenHash      String           @unique @map("token_hash") @db.Char(64)
  status         InvitationStatus @default(PENDING)

  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  /// At most one invite per email per org per status. Because status is part of
  /// the key, a REVOKED invite does not block re-inviting the same person.
  @@unique([organizationId, email, status])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

// ---------------------------------------------------------------------------
// Audit (Section 10.2, Section 33)
// ---------------------------------------------------------------------------

/// Append-only. Section 33: never hard-delete audit records to tidy the UI.
/// There is deliberately no updatedAt and no update path in the repository.
model AuditLog {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Nullable: system and worker actions have no human actor.
  actorId        String? @map("actor_id") @db.Uuid

  /// Past tense, "<entity>.<event>", e.g. "membership.role_assigned".
  action     String @db.VarChar(80)
  entityType String @map("entity_type") @db.VarChar(60)
  entityId   String @map("entity_id") @db.Uuid

  /// Before/after diff plus request context. JSONB so it stays queryable.
  metadata Json? @db.JsonB

  ipAddress String? @map("ip_address") @db.Inet
  requestId String? @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// "Show this org's audit trail, newest first" (Section 10.3: index created_at
  /// for time-based audit queries).
  @@index([organizationId, createdAt])
  /// "Show the history of this one record."
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// People (report Section 3.1, module "People")
// ---------------------------------------------------------------------------

/// A department. Self-referencing, so departments form a TREE per tenant:
/// Engineering -> Backend -> Payments.
///
/// Section 26.1 lists "Org hierarchy — Tree — adjacency map + DFS/BFS for
/// reporting chains". `parentId` is that adjacency edge. The cycle guard lives
/// in the service layer, because a foreign key cannot express "must not be my
/// own ancestor".
model Department {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String  @db.VarChar(120)
  /// Tenant-local short code, e.g. "ENG". Used in employee codes and reports.
  code           String  @db.VarChar(16)
  description    String? @db.VarChar(255)

  /// Null for a top-level department. The tree root set is every row with no parent.
  parentId String? @map("parent_id") @db.Uuid
  /// Department head. Nullable: a department can exist before it has one.
  headId   String? @map("head_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// onDelete: Restrict — deleting a department with children would orphan a
  /// whole subtree. The API requires it be emptied or re-parented first.
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Department[] @relation("DepartmentTree")
  head         Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@index([organizationId, name])
  @@map("departments")
}

/// An employee record.
///
/// Deliberately separate from `User`. A User is a login; an Employee is a
/// person the company employs. They are not the same thing: a contractor may
/// have a login and no employee record, and someone hired next month has an
/// employee record before their account exists. `userId` is nullable and
/// unique, linking the two when both are present.
model Employee {
  id             String  @id @default(uuid(7)) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Optional link to a login. Null until the person is invited and accepts.
  userId         String? @map("user_id") @db.Uuid

  /// Tenant-local identifier, e.g. "ENG-014".
  employeeCode String @map("employee_code") @db.VarChar(24)

  firstName     String  @map("first_name") @db.VarChar(60)
  lastName      String  @map("last_name") @db.VarChar(60)
  workEmail     String  @map("work_email") @db.VarChar(320)
  personalEmail String? @map("personal_email") @db.VarChar(320)
  phone         String? @db.VarChar(24)

  designation    String           @db.VarChar(120)
  employmentType EmploymentType   @default(FULL_TIME) @map("employment_type")
  status         EmploymentStatus @default(ACTIVE)
  workMode       WorkMode         @default(OFFICE) @map("work_mode")
  location       String?          @db.VarChar(120)

  joinedOn DateTime  @map("joined_on") @db.Date
  exitedOn DateTime? @map("exited_on") @db.Date

  departmentId String? @map("department_id") @db.Uuid
  /// Reporting line. Self-referencing, so managers form a TREE and a chain to
  /// the top can be walked. Cycle prevention is enforced in the service layer.
  managerId    String? @map("manager_id") @db.Uuid

  /// Optimistic concurrency (Section 11.2): two HR users editing one profile.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: a manager leaving must not delete their reports.
  manager            Employee?       @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]      @relation("ReportingLine")
  headedDepartments  Department[]    @relation("DepartmentHead")
  ownedProjects      Project[]       @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  reportedTasks      Task[]          @relation("TaskReporter")

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  /// One employee record per login, per tenant.
  @@unique([organizationId, userId])
  /// "List active employees in this org" — the directory query.
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  /// "Who reports to this manager?" — walked repeatedly by the tree traversal.
  @@index([organizationId, managerId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT

  @@map("employment_type")
}

enum EmploymentStatus {
  ACTIVE
  ON_NOTICE
  ON_LEAVE
  EXITED

  @@map("employment_status")
}

enum WorkMode {
  OFFICE
  REMOTE
  HYBRID

  @@map("work_mode")
}

// ---------------------------------------------------------------------------
// Work — projects and tasks (report Section 3.1, modules "Projects"/"Tasks")
// ---------------------------------------------------------------------------

model Project {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(160)
  /// Short prefix for task keys, e.g. "VEP" -> VEP-1, VEP-2.
  key            String        @db.VarChar(10)
  description    String?       @db.VarChar(1000)
  status         ProjectStatus @default(PLANNING)
  priority       Priority      @default(MEDIUM)

  startDate DateTime? @map("start_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date

  /// Section 28.2: Money is amount + currency, and NEVER a float.
  /// Decimal(14,2) stores exact base units; a float drifts on the first division.
  budgetAmount   Decimal? @map("budget_amount") @db.Decimal(14, 2)
  budgetCurrency String?  @map("budget_currency") @db.Char(3)

  /// Monotonic counter for task keys. Incremented inside the same transaction
  /// that creates a task, so two concurrent creates cannot both take VEP-7.
  taskSequence Int @default(0) @map("task_sequence")

  ownerId String? @map("owner_id") @db.Uuid
  version Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        Employee?       @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("project_status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("priority")
}

model ProjectMember {
  projectId  String @map("project_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid
  /// Free-form within the project, e.g. "Tech Lead". Distinct from an RBAC
  /// role: this describes contribution, not permission.
  role       String @default("Contributor") @db.VarChar(60)

  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@index([employeeId])
  @@map("project_members")
}

/// A task. `status` moves through the state machine in Section 8.1; illegal
/// transitions are rejected by the service, not merely discouraged.
model Task {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  /// Human-facing identifier, e.g. "VEP-42". Unique per tenant.
  key            String     @db.VarChar(24)
  title          String     @db.VarChar(240)
  description    String?    @db.VarChar(4000)
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)

  assigneeId String? @map("assignee_id") @db.Uuid
  reporterId String? @map("reporter_id") @db.Uuid

  dueDate       DateTime? @map("due_date") @db.Date
  /// Estimate in hours. Feeds the critical-path weight.
  estimateHours Decimal?  @map("estimate_hours") @db.Decimal(6, 2)
  actualHours   Decimal?  @map("actual_hours") @db.Decimal(6, 2)

  /// Sub-tasks. A tree, and deliberately separate from the dependency DAG
  /// below, because "part of" is not the same relation as "must finish before".
  parentId String? @map("parent_id") @db.Uuid

  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  version     Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter     Employee?    @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent       Task?        @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("SubTasks")

  /// Edges of the dependency DAG, in both directions.
  blockedBy TaskDependency[] @relation("Successor")
  blocks    TaskDependency[] @relation("Predecessor")
  comments  TaskComment[]

  @@unique([organizationId, key])
  @@index([organizationId, projectId, status])
  @@index([organizationId, assigneeId, status])
  @@index([projectId, parentId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE

  @@map("task_status")
}

/// One edge of the dependency graph: `predecessor` must finish before
/// `successor` can start.
///
/// Unlike Department.parentId this is many-to-many, which is exactly why the
/// structure is a DAG and not a tree, and why cycle detection here needs a real
/// graph traversal rather than walking a single chain of parents.
model TaskDependency {
  organizationId String @map("organization_id") @db.Uuid
  predecessorId  String @map("predecessor_id") @db.Uuid
  successorId    String @map("successor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  /// The composite primary key makes a duplicate edge impossible. Self-edges
  /// and longer cycles still need the application check.
  @@id([predecessorId, successorId])
  @@index([organizationId])
  @@index([successorId])
  @@map("task_dependencies")
}

model TaskComment {
  id             String @id @default(uuid(7)) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  taskId         String @map("task_id") @db.Uuid
  authorId       String @map("author_id") @db.Uuid
  body           String @db.VarChar(4000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, taskId, createdAt])
  @@map("task_comments")
}

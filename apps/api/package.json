{
  "name": "@businessos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cross-env NODE_ENV=test LOG_LEVEL=silent vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@businessos/contracts": "workspace:*",
    "@businessos/database": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@prisma/client": "7.9.1",
    "bullmq": "catalog:",
    "dotenv": "^17.4.2",
    "fastify": "catalog:",
    "fastify-plugin": "^6.0.0",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@businessos/config": "workspace:*",
    "@businessos/eslint-config": "workspace:*",
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

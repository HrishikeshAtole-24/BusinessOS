# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Environment — never commit real credentials.
# .env.example IS committed; everything else is not.
.env
.env.*
!.env.example

# Prisma
prisma/*.db
prisma/*.db-journal

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local scratch
tmp/
.cache/

/generated/prisma

# Prisma generated client (Prisma 7 emits to a real directory, not node_modules)
packages/database/src/generated/

# AI agent tooling. `prisma init` vendors ~480K of skill docs into .agents/;
# skills-lock.json is committed so they can be restored reproducibly.
.agents/
.claude/
.windsurf/

# Next.js
apps/web/.next/
apps/web/next-env.d.ts

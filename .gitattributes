# Normalize to LF in the repository. Developers may be on Windows, but CI,
# Docker images and production all run Linux — a CRLF shell script or Dockerfile
# fails there in ways that are annoying to diagnose.
* text=auto eol=lf

# Binary: never touch these.
*.docx  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml   linguist-generated=true -diff
generated/**     linguist-generated=true
docs/reference/** linguist-documentation=true

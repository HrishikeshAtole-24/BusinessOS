# BusinessOS — environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.
# Never commit real credentials (Section 18.4: "redact secrets from logs" — the
# same rule applies to version control).
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database — Neon (PostgreSQL 18)
# ---------------------------------------------------------------------------
# Neon gives you two connection strings. They are NOT interchangeable:
#
#   DATABASE_URL  -> the POOLED string (host contains "-pooler").
#                    Used by the API and worker at runtime. PgBouncer sits in
#                    front of it, which is what lets many short-lived serverless
#                    connections share a small pool.
#
#   DIRECT_URL    -> the UNPOOLED string (no "-pooler" in the host).
#                    Used by `prisma migrate`. Migrations issue DDL and advisory
#                    locks that a transaction-mode pooler will not carry, so
#                    running them through the pooler fails in confusing ways.
#
# Note `sslmode=verify-full`, not the `sslmode=require` Neon hands you. `pg`
# currently treats them as the same thing, but pg v9 will give `require` the
# weaker libpq meaning (encrypt, but do not verify the certificate) — which is
# open to a man-in-the-middle. Being explicit keeps today's behaviour after
# that change.
#
# Find both at: Neon Console -> your project -> Connect -> toggle "Connection pooling"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/businessos?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/businessos?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Redis — Upstash
# ---------------------------------------------------------------------------
# Use the `rediss://` (TLS) URL, not `redis://`.
# Upstash Console -> your database -> Connect -> "ioredis" / Redis URL.
#
# BullMQ requires `maxRetriesPerRequest: null` on its connection; that is set in
# code, not here. Section 15: Redis is cache + queue + ephemeral state only,
# never a second source of truth.
REDIS_URL="rediss://default:PASSWORD@REGION-xxxx.upstash.io:6379"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT="4000"
API_HOST="0.0.0.0"

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sessions (Section 18.2)
# ---------------------------------------------------------------------------
# 32+ random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every live session, which is the intended
# break-glass response to a suspected leak.
SESSION_SECRET="CHANGE_ME_generate_a_32_byte_random_value"
SESSION_TTL_HOURS="168"
SESSION_COOKIE_NAME="businessos.sid"

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_PORT="3000"

# ---------------------------------------------------------------------------
# Observability (Section 19)
# ---------------------------------------------------------------------------
LOG_LEVEL="debug"
OTEL_SERVICE_NAME="businessos-api"
# Leave empty to disable OTLP export while developing locally.
OTEL_EXPORTER_OTLP_ENDPOINT=""
